# GoVIBE Frontend Configuration (.env.example)

# FastAPI Backend URL
VITE_API_BASE_URL=http://localhost:8000/api

# Set to true only for demo/testing. Default false for a real app experience.
VITE_ENABLE_DEMO_MODE=false

# Google Maps API Key (Optional - Leaflet interactive map runs seamlessly without key)
VITE_GOOGLE_MAPS_API_KEY=

# Firebase Authentication (Optional - Built-in demo/local auth works seamlessly)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
