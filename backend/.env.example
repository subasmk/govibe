# GoVIBE Backend Configuration (.env.example)

# App Environment & Port
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Database Configuration (Defaults to local sqlite:///./govibe.db if left empty)
DATABASE_URL=postgresql://postgres:password@localhost:5432/govibe_db

# AI Configuration
# Use OpenRouter for API keys that start with sk-or-
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional fallback: Google Gemini
GEMINI_API_KEY=

# AWS S3 Configuration (For Travel Photos & Media Uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=govibe-travel-media

# Firebase Admin SDK Configuration (Optional - for server-side token validation)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
