[Unit]
Description=GoVIBE FastAPI Service
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/sih/backend
Environment="PATH=/home/ubuntu/sih/backend/venv/bin"
ExecStart=/home/ubuntu/sih/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 4
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
